{
  "name": "riccardosirigu.github.io",
  "private": true,
  "description": "Riccardo Sirigu's personal website and Markdown blog, built with Astro, TypeScript, React and Styled Components.",
  "version": "1.0.0",
  "author": "Riccardo Sirigu",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.2"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@loadable/component": "^5.16.7",
    "astro": "^7.2.10",
    "framer-motion": "^13.1.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet": "^6.1.0",
    "react-slick": "^0.31.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-helmet": "^6.1.11",
    "@types/react-slick": "^0.23.13",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "astro",
    "react",
    "typescript",
    "styled-components"
  ],
  "license": "MIT",
  "scripts": {
    "build": "astro build && node scripts/postbuild.mjs",
    "check": "astro check",
    "clean": "astro clean",
    "deploy": "npm run build && gh-pages -d dist --nojekyll",
    "dev": "astro dev",
    "develop": "astro dev",
    "format": "prettier --write \"**/*.{astro,js,jsx,json,md,ts,tsx}\"",
    "preview": "astro preview",
    "serve": "astro preview",
    "start": "astro dev",
    "test": "npm run check && npm run verify",
    "verify": "node scripts/verify-build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ricsirigu/ricsirigu.github.io.git"
  }
}
