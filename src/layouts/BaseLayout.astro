---
import 'prismjs/themes/prism-solarizedlight.css';
import 'assets/styles/global.css';

import { siteMetadata } from 'lib/site';

interface BlogMetadata {
  date: string;
  image?: string;
  slug: string;
}

interface Props {
  blog?: BlogMetadata;
  description?: string;
  styledStyleTags: string;
  title: string;
}

const {
  blog,
  description = siteMetadata.description,
  styledStyleTags,
  title,
} = Astro.props;

const defaultImage = '/static/6716eff14ad2af05b485ed7fcbddcf80/1fb14/riccardo-sirigu.webp';
const imagePath = blog?.image || defaultImage;
const imageUrl = `${siteMetadata.siteUrl}${imagePath}`;
const imageWidth = blog?.image ? 1200 : 960;
const imageHeight = blog?.image ? 630 : 960;
const pageUrl = blog ? `${siteMetadata.siteUrl}${blog.slug}` : siteMetadata.siteUrl;
const datePublished = blog?.date || new Date().toISOString().split('T')[0];

const baseSchema = {
  '@context': 'http://schema.org',
  '@type': 'WebSite',
  url: pageUrl,
  name: title,
  alternateName: title,
};

const schema = blog
  ? [
      baseSchema,
      {
        '@context': 'http://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            item: { '@id': pageUrl, name: title, image: imageUrl },
          },
        ],
      },
      {
        '@context': 'http://schema.org',
        '@type': 'BlogPosting',
        url: pageUrl,
        name: title,
        alternateName: title,
        headline: title,
        image: { '@type': 'ImageObject', url: imageUrl },
        description,
        author: { '@type': 'Person', name: siteMetadata.author },
        publisher: {
          '@type': 'Organization',
          url: siteMetadata.organization.url,
          logo: {
            '@type': 'ImageObject',
            url: `${siteMetadata.siteUrl}/static/6716eff14ad2af05b485ed7fcbddcf80/1fb14/riccardo-sirigu.webp`,
          },
          name: siteMetadata.organization.name,
        },
        mainEntityOfPage: { '@type': 'WebSite', '@id': siteMetadata.siteUrl },
        datePublished,
        dateModified: datePublished,
      },
    ]
  : [baseSchema];

const iconVersion = '572fe588d98a7211c32f49b0c1c05427';
const iconSizes = [48, 72, 96, 144, 192, 256, 384, 512];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <title>{title} | {siteMetadata.title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={siteMetadata.author} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href={`/favicon-32x32.png?v=${iconVersion}`} type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="anonymous" />
    <meta name="theme-color" content="#81e6d9" />
    {iconSizes.map((size) => (
      <link rel="apple-touch-icon" sizes={`${size}x${size}`} href={`/icons/icon-${size}x${size}.png?v=${iconVersion}`} />
    ))}
    {schema.map((entry) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
    ))}
    <Fragment set:html={styledStyleTags} />
  </head>
  <body>
    <slot />
  </body>
</html>
