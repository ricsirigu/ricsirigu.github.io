---
import AuthorityPage from 'components/AuthorityPage';
import BaseLayout from 'layouts/BaseLayout.astro';
import { collectStyles } from 'lib/collectStyles';

const props = {
  currentPath: '/speaking-contributions/',
  breadcrumbs: [],
  eyebrow: 'Contributions',
  title: 'Cybersecurity Standards, Open Knowledge and Technical Education',
  summary:
    "I contribute to European cybersecurity standardization, OWASP projects, technical education, and independent writing. These are some of the activities I have been involved in.",
  highlights: [
    {
      href: 'https://cyberstand.eu/experts/riccardo-sirigu',
      label: 'CEN/CENELEC JTC 13/WG 9',
      description: 'Work on horizontal cybersecurity standards supporting the Cyber Resilience Act.',
      external: true,
    },
    {
      href: 'https://genai.owasp.org/team/riccardo-sirigu/',
      label: 'OWASP GenAI Security Project',
      description: 'Contributor profile in the global OWASP GenAI community.',
      external: true,
    },
    {
      href: 'https://www.udacity.com/course/secure-coding-for-embedded-systems--cd13387',
      label: 'Secure Coding for Embedded Systems',
      description: 'Udacity course contribution covering hardening, supply chain, TLS and secure updates.',
      external: true,
    },
    {
      href: '/blog/',
      label: 'Independent technical writing',
      description: 'Articles connecting attacks, engineering decisions and cybersecurity regulation.',
    },
  ],
  sections: [
    {
      title: 'European cybersecurity standardization',
      paragraphs: [
        "I take part in CEN/CENELEC JTC 13/WG 9, with support from Cyberstand, contributing to the development of the EN 40000 series of horizontal cybersecurity standards supporting the Cyber Resilience Act. The work involves turning regulatory requirements into technical guidance that manufacturers can apply when designing, developing, and maintaining their products.",
      ],
    },
    {
      title: 'OWASP and open security knowledge',
      paragraphs: [
        "I have contributed to the OWASP Mobile Security Testing Guide (MSTG), Web Security Testing Guide (WSTG), and GenAI Security Project. I have also translated resources into Italian, including OWASP Top 10 (2021), ASVS, the LLM AI Cybersecurity & Governance Checklist, and OWASP LLM Top 10, making them easier to access for Italian-speaking readers.",
      ],
    },
    {
      title: 'Technical education and speaking',
      paragraphs: [
        "I developed and delivered modules for Udacity’s Secure Coding for Embedded Systems course, covering system hardening, secure updates, TLS, and software supply-chain risks. I am also available for technical talks, panels, workshops, and discussions on offensive security, Secure by Design, product security, and the Cyber Resilience Act.",
      ],
    },
  ],
  relatedLinks: [
    {
      href: '/about/',
      label: 'Full professional profile',
      description: 'Role, experience, areas of focus and independent references.',
    },
    {
      href: '/contact/',
      label: 'Speaking and media enquiries',
      description: 'Get in touch about events, interviews, workshops and professional work.',
    },
  ],
};
const styledStyleTags = collectStyles(AuthorityPage, props);
---

<BaseLayout
  title="Cybersecurity Contributions and Speaking"
  description="Selected cybersecurity standards, OWASP, technical education and speaking contributions by Riccardo Sirigu."
  pageType="CollectionPage"
  collectionItems={props.highlights.map((item) => ({ name: item.label, url: item.href }))}
  breadcrumbs={[{ name: 'Contributions', url: '/speaking-contributions/' }]}
  styledStyleTags={styledStyleTags}
>
  <AuthorityPage {...props} />
</BaseLayout>
