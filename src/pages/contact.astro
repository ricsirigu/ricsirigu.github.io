---
import ContactPage from 'react-pages/ContactPage';
import BaseLayout from 'layouts/BaseLayout.astro';
import { getItems, getSection } from 'lib/content';
import { collectStyles } from 'lib/collectStyles';
import type { ComponentProps } from 'react';

type PageProps = ComponentProps<typeof ContactPage>;

const props: PageProps = {
  contacts: getItems<PageProps['contacts'][number]['node']['frontmatter']>('contact')
    .map(({ id, frontmatter }) => ({ node: { id, frontmatter } })),
  currentPath: '/contact/',
  sectionTitle: getSection<PageProps['sectionTitle']>('contact section'),
};
const styledStyleTags = collectStyles(ContactPage, props);
---

<BaseLayout
  title="Contact Riccardo Sirigu"
  description="Contact Riccardo Sirigu about offensive security, Secure by Design, product security, technical training, media and speaking enquiries."
  pageType="ContactPage"
  styledStyleTags={styledStyleTags}
>
  <ContactPage {...props} />
</BaseLayout>
