---
import BlogPage from 'react-pages/BlogPage';
import BaseLayout from 'layouts/BaseLayout.astro';
import { getBlogTopics, getPublishedBlogPosts, getSection } from 'lib/content';
import { collectStyles } from 'lib/collectStyles';
import type { ComponentProps } from 'react';

type PageProps = ComponentProps<typeof BlogPage>;

const props: PageProps = {
  currentPath: '/blog/',
  sectionTitle: getSection<PageProps['sectionTitle']>('blog section'),
  topics: getBlogTopics(),
  posts: getPublishedBlogPosts()
    .map((post) => ({
      node: {
        id: post.id,
        fields: post.fields,
        frontmatter: {
          title: post.frontmatter.title,
          description: post.frontmatter.description,
          date: post.frontmatter.formattedDate,
          publishedDate: post.frontmatter.date,
          tags: post.frontmatter.tags,
          cover: post.frontmatter.coverImage || {
            height: 1,
            sizes: '100vw',
            srcSet: '',
            url: post.frontmatter.coverUrl || '',
            width: 1,
          },
        },
      },
    })),
};
const styledStyleTags = collectStyles(BlogPage, props);
---

<BaseLayout
  title="Cybersecurity and Software Engineering Blog"
  description="Articles by Riccardo Sirigu about secure-by-design engineering, application security, the Cyber Resilience Act and software development."
  pageType="CollectionPage"
  collectionItems={getPublishedBlogPosts().map((post) => ({ name: post.frontmatter.title, url: post.fields.slug }))}
  styledStyleTags={styledStyleTags}
>
  <BlogPage {...props} />
</BaseLayout>
