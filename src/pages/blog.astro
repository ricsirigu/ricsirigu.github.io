---
import BlogPage from 'react-pages/BlogPage';
import BaseLayout from 'layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { getBlogTopics, getPublishedBlogPosts, getSection } from 'lib/content';
import { collectStyles } from 'lib/collectStyles';
import type { ComponentProps } from 'react';

type PageProps = ComponentProps<typeof BlogPage>;

const sectionTitle = getSection<PageProps['sectionTitle']>('blog section');
const topics = await getBlogTopics();
const published = await getPublishedBlogPosts();
const posts = await Promise.all(
  published.map(async (post) => {
    const cover = await getImage({ src: post.data.cover, width: 720, layout: 'constrained' });
    return {
      node: {
        id: post.id,
        fields: post.fields,
        frontmatter: {
          title: post.data.title,
          description: post.data.description,
          date: post.formattedDate,
          publishedDate: post.data.date.toISOString().slice(0, 10),
          tags: post.data.tags,
          cover: {
            src: cover.src,
            srcSet: cover.srcSet.attribute,
            sizes: cover.rawOptions.sizes,
            width: cover.rawOptions.width,
            height: cover.rawOptions.height,
          },
        },
      },
    };
  }),
);
const props: PageProps = {
  currentPath: '/blog/',
  sectionTitle,
  topics,
  posts,
};
const styledStyleTags = collectStyles(BlogPage, props);
---

<BaseLayout
  title="Cybersecurity and Software Engineering Blog"
  description="Articles by Riccardo Sirigu about secure-by-design engineering, application security, the Cyber Resilience Act and software development."
  pageType="CollectionPage"
  collectionItems={published.map((post) => ({ name: post.data.title, url: post.fields.slug }))}
  styledStyleTags={styledStyleTags}
>
  <BlogPage {...props} />
</BaseLayout>