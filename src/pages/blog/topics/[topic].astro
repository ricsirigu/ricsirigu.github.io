---
import BlogPage from 'react-pages/BlogPage';
import BaseLayout from 'layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { getBlogTopics, getPublishedBlogPosts } from 'lib/content';
import { collectStyles } from 'lib/collectStyles';
import type { ComponentProps } from 'react';

type PageProps = ComponentProps<typeof BlogPage>;

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  const topics = await getBlogTopics();

  return topics.map((topic) => ({
    params: { topic: topic.slug },
    props: {
      topic,
      topics,
      topicPosts: posts.filter((post) =>
        post.data.tags.some((tag) => tag.toLowerCase() === topic.name.toLowerCase()),
      ),
    },
  }));
}

const { topic, topics, topicPosts } = Astro.props;
const topicMetadata =
  topic.slug === 'cra'
    ? {
        title: 'Cyber Resilience Act: Articles and Practical Analysis',
        description:
          'Articles by Riccardo Sirigu on the Cyber Resilience Act, product security and practical compliance misconceptions.',
        heading: 'Cyber Resilience Act',
        introduction:
          'Practical analysis for manufacturers, software vendors and product security teams, with a focus on engineering readiness, risk assessment and compliance misconceptions.',
      }
    : {
        title: `${topic.name} articles`,
        description: `Articles by Riccardo Sirigu about ${topic.name}, secure software engineering and cybersecurity.`,
        heading: topic.name,
        introduction: undefined,
      };
const posts = await Promise.all(
  topicPosts.map(async (post) => {
    const cover = await getImage({ src: post.data.cover, width: 720, layout: 'constrained' });
    return {
      node: {
        id: post.id,
        fields: post.fields,
        frontmatter: {
          title: post.data.title,
          description: post.data.description,
          date: post.formattedDate,
          publishedDate: post.data.date.toISOString().slice(0, 10),
          tags: post.data.tags,
          cover: {
            src: cover.src,
            srcSet: cover.srcSet.attribute,
            sizes: cover.rawOptions.sizes,
            width: cover.rawOptions.width,
            height: cover.rawOptions.height,
          },
        },
      },
    };
  }),
);
const props: PageProps = {
  activeTopic: topic.slug,
  currentPath: `/blog/topics/${topic.slug}/`,
  introduction: topicMetadata.introduction,
  sectionTitle: { title: 'Blog topic', subtitle: topicMetadata.heading },
  topics,
  posts,
};
const styledStyleTags = collectStyles(BlogPage, props);
---

<BaseLayout
  title={topicMetadata.title}
  description={topicMetadata.description}
  pageType="CollectionPage"
  collectionItems={topicPosts.map((post) => ({ name: post.data.title, url: post.fields.slug }))}
  styledStyleTags={styledStyleTags}
>
  <BlogPage {...props} />
</BaseLayout>