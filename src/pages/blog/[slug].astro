---
import BlogPostPage from 'templates/BlogPost';
import BaseLayout from 'layouts/BaseLayout.astro';
import { getBlogPosts } from 'lib/content';
import { collectStyles } from 'lib/collectStyles';

export function getStaticPaths() {
  const posts = getBlogPosts();

  return posts.map((post, index) => {
    const previous = index === posts.length - 1 ? null : posts[index + 1];
    const next = index === 0 ? null : posts[index - 1];

    return {
      params: { slug: post.fields.slug.split('/').filter(Boolean).pop() },
      props: { post, previous, next },
    };
  });
}

const { post, previous, next } = Astro.props;
const props = {
  data: { markdownRemark: post },
  pageContext: { slug: post.fields.slug, previous, next },
};
const styledStyleTags = collectStyles(BlogPostPage, props);
---

<BaseLayout
  title={post.frontmatter.title}
  description={post.frontmatter.description || post.excerpt}
  blog={{ date: post.frontmatter.date, image: post.frontmatter.coverUrl, slug: post.fields.slug }}
  styledStyleTags={styledStyleTags}
>
  <BlogPostPage {...props} client:load />
</BaseLayout>
