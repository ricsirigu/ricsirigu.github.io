---
import AuthorityPage from 'components/AuthorityPage';
import BaseLayout from 'layouts/BaseLayout.astro';
import { collectStyles } from 'lib/collectStyles';
import { expertisePages } from 'lib/authority';

const props = {
  currentPath: '/expertise/',
  breadcrumbs: [],
  eyebrow: 'Expertise',
  title: 'Attack-Informed Security for Products and Engineering Organizations',
  summary:
    "A penetration test can tell us where a system breaks. What interests me more is understanding why it breaks, whether the same problem could exist somewhere else, and what would make it harder to repeat. That is where offensive security, Secure by Design, and product security requirements start to connect.",
  highlights: expertisePages.map((page) => ({
    href: `/expertise/${page.slug}/`,
    label: page.eyebrow,
    description: page.summary,
  })),
  sections: [
    {
      title: "Why these areas belong together",
      paragraphs: [
        "An attack shows us where an assumption fails. Secure by Design helps us change the architecture or development practices behind it. Product security requirements, including those introduced by the CRA, make us consider how those decisions hold up throughout the product lifecycle, who is responsible for them, and how they are documented.",
        "They are different activities, but treating them as separate checklists usually misses the point.",
      ],
    },
  ],
  relatedLinks: [
    {
      href: '/about/',
      label: 'About Riccardo Sirigu',
      description: 'Professional profile, focus areas and independent references.',
    },
    {
      href: '/blog/',
      label: 'Technical writing',
      description: 'Original articles on cybersecurity, engineering and regulation.',
    },
  ],
};
const styledStyleTags = collectStyles(AuthorityPage, props);
---

<BaseLayout
  title="Offensive Security and Secure-by-Design Expertise"
  description="Attack-informed guidance on offensive security, secure-by-design engineering, product security and Cyber Resilience Act readiness."
  pageType="CollectionPage"
  collectionItems={expertisePages.map((page) => ({ name: page.title, url: `/expertise/${page.slug}/` }))}
  breadcrumbs={[{ name: 'Expertise', url: '/expertise/' }]}
  styledStyleTags={styledStyleTags}
>
  <AuthorityPage {...props} />
</BaseLayout>
